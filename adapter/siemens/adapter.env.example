# Copy to adapter.env on the Pi and edit IP_MACHINE.
# Values below match the MA-64 field tests (DMG MORI DMU 65, 840D sl):
#   snap7 connect("192.168.1.100", rack=0, slot=2)  — same as
#   utils/s7/s7_find_strings.py

SIEMENS_FAMILY=840d_sl

# PLC. Rack is hardcoded 0 in adapter.py (840D sl / S7-300 layout).
IP_MACHINE=192.168.1.100
PLC_SLOT=2

# Leave PROGRAM_DB unset until a specialist confirms the builder block
# by changing the NC program at the control and watching which DB follows.
# The S7 ingest never had a proven value either — it required PROGRAM_DB
# in machine.env with no default.
#
# Do NOT set 99. On MA-64, DB99@0 is the boot software STRING
# "3DA000_SCSR_04p_HF01" (HotFix), not the part program.
# A sibling machine was rumoured to use DB100; that is unproven here.
#
# When you have a proven block, uncomment and use a number (not "DB100"):
# PROGRAM_DB=100
# PROGRAM_OFFSET=0
# PROGRAM_CAPACITY=64
