# Copy to adapter.env on the Pi and edit IP_MACHINE.
# Values below match the MA-64 field tests (DMG MORI DMU 65, 840D sl):
#   snap7 connect("192.168.1.100", rack=0, slot=2)  — same as
#   utils/s7/s7_find_strings.py

SIEMENS_FAMILY=840d_sl

# PLC. Rack is hardcoded 0 in adapter.py (840D sl / S7-300 layout).
IP_MACHINE=192.168.1.100
PLC_SLOT=2

# Builder block confirmed by Siemens technicians (MA-64):
#   Mode     DB90.DBX376.0  STRING[15]
#   Status   DB90.DBX394.0  STRING[15]
#   Program  DB90.DBX412.0  STRING[160]   (162 bytes on the wire)
#   Clock    DB90.DBX574.0  DATE_AND_TIME (8 bytes BCD)
# PROGRAM_DB in this file is ignored for 840d_sl — the pack owns DB90.
#
# Do NOT use DB99. On MA-64, DB99@0 is the boot software STRING
# "3DA000_SCSR_04p_HF01" (HotFix), not the part program.
